module {
  aie.device(npu2_1col) {
    %shim_noc_tile_0_0 = aie.tile(0, 0)
    %mem_tile_0_1 = aie.tile(0, 1)
    %tile_0_2 = aie.tile(0, 2)
    
    memref.global "public" @global_res_0_0 : memref<2048xf32>
    memref.global "public" @global_lhs_0_0 : memref<2048xf32>
    memref.global "public" @global_rhs_0_0 : memref<1024xf32>

    %buf_lhs_0_1 = aie.buffer(%mem_tile_0_1) {sym_name = "buf_lhs_0_1"} : memref<2048xf32> 
    %buf_rhs_0_1 = aie.buffer(%mem_tile_0_1) {sym_name = "buf_rhs_0_1"} : memref<1024xf32> 
    %buf_res_0_1 = aie.buffer(%mem_tile_0_1) {sym_name = "buf_res_0_1"} : memref<2048xf32> 

    %buf_lhs_0_1_prod_lock = aie.lock(%mem_tile_0_1, 0) {init = 1 : i32, sym_name = "buf_lhs_0_1_prod_lock"}
    %buf_lhs_0_1_cons_lock = aie.lock(%mem_tile_0_1, 1) {init = 0 : i32, sym_name = "buf_lhs_0_1_cons_lock"}
    %buf_rhs_0_1_prod_lock = aie.lock(%mem_tile_0_1, 2) {init = 1 : i32, sym_name = "buf_rhs_0_1_prod_lock"}
    %buf_rhs_0_1_cons_lock = aie.lock(%mem_tile_0_1, 3) {init = 0 : i32, sym_name = "buf_rhs_0_1_cons_lock"}
    %buf_res_0_1_prod_lock = aie.lock(%mem_tile_0_1, 4) {init = 1 : i32, sym_name = "buf_res_0_1_prod_lock"}
    %buf_res_0_1_cons_lock = aie.lock(%mem_tile_0_1, 5) {init = 0 : i32, sym_name = "buf_res_0_1_cons_lock"}

    %buf_lhs_0_2 = aie.buffer(%tile_0_2) {sym_name = "buf_lhs_0_2"} : memref<1024xf32> 
    %buf_rhs_0_2 = aie.buffer(%tile_0_2) {sym_name = "buf_rhs_0_2"} : memref<1024xf32> 
    %buf_res_0_2 = aie.buffer(%tile_0_2) {sym_name = "buf_res_0_2"} : memref<1024xf32> 

    %buf_lhs_0_2_prod_lock = aie.lock(%tile_0_2, 0) {init = 1 : i32, sym_name = "buf_lhs_0_2_prod_lock"}
    %buf_lhs_0_2_cons_lock = aie.lock(%tile_0_2, 1) {init = 0 : i32, sym_name = "buf_lhs_0_2_cons_lock"}
    %buf_rhs_0_2_prod_lock = aie.lock(%tile_0_2, 2) {init = 1 : i32, sym_name = "buf_rhs_0_2_prod_lock"}
    %buf_rhs_0_2_cons_lock = aie.lock(%tile_0_2, 3) {init = 0 : i32, sym_name = "buf_rhs_0_2_cons_lock"}
    %buf_res_0_2_prod_lock = aie.lock(%tile_0_2, 4) {init = 1 : i32, sym_name = "buf_res_0_2_prod_lock"}
    %buf_res_0_2_cons_lock = aie.lock(%tile_0_2, 5) {init = 0 : i32, sym_name = "buf_res_0_2_cons_lock"}

    aie.flow(%shim_noc_tile_0_0, DMA : 0, %mem_tile_0_1, DMA : 0)
    aie.flow(%shim_noc_tile_0_0, DMA : 1, %mem_tile_0_1, DMA : 1)
    aie.flow(%mem_tile_0_1, DMA : 0, %shim_noc_tile_0_0, DMA : 0)

    aie.flow(%mem_tile_0_1, DMA : 1, %tile_0_2, DMA : 0)
    aie.flow(%mem_tile_0_1, DMA : 5, %tile_0_2, DMA : 1)

    aie.flow(%tile_0_2, DMA : 0, %mem_tile_0_1, DMA : 2)

    aie.shim_dma_allocation @global_res_0_0(S2MM, 0, 0)
    aie.shim_dma_allocation @global_lhs_0_0(MM2S, 0, 0)
    aie.shim_dma_allocation @global_rhs_0_0(MM2S, 1, 0)

    %memtile_dma_0_1 = aie.memtile_dma(%mem_tile_0_1) {
      %0 = aie.dma_start(S2MM, 0, ^bb6, ^bb1)
    ^bb1:  // pred: ^bb0
      %1 = aie.dma_start(S2MM, 1, ^bb7, ^bb2)
    ^bb2:  // pred: ^bb1
      %2 = aie.dma_start(S2MM, 2, ^bb8, ^bb3)
    ^bb3:  // pred: ^bb3
      %3 = aie.dma_start(MM2S, 0, ^bb9, ^bb4)
    ^bb4:  // pred: ^bb4
      %4 = aie.dma_start(MM2S, 1, ^bb10, ^bb5)
    ^bb5:  // pred: ^bb6
      %5 = aie.dma_start(MM2S, 5, ^bb11, ^bb12)
    ^bb6:  // 2 preds: ^bb0, ^bb6
      aie.use_lock(%buf_lhs_0_1_prod_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_lhs_0_1 : memref<2048xf32>, 0, 2048)
      aie.use_lock(%buf_lhs_0_1_cons_lock, Release, 1)
      aie.next_bd ^bb6
    ^bb7:  // 2 preds: ^bb1, ^bb7
      aie.use_lock(%buf_rhs_0_1_prod_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_rhs_0_1 : memref<1024xf32>, 0, 1024)
      aie.use_lock(%buf_rhs_0_1_cons_lock, Release, 1)
      aie.next_bd ^bb7
    ^bb8:  // 2 preds: ^bb2, ^bb8
      aie.use_lock(%buf_res_0_1_prod_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_res_0_1 : memref<2048xf32>, 0, 1024)
      aie.use_lock(%buf_res_0_1_cons_lock, Release, 1)
      aie.next_bd ^bb8
    ^bb9:  // 2 preds: ^bb3, ^bb9
      aie.use_lock(%buf_res_0_1_cons_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_res_0_1 : memref<2048xf32>, 0, 2048)
      aie.use_lock(%buf_res_0_1_prod_lock, Release, 1)
      aie.next_bd ^bb9
    ^bb10:  // 2 preds: ^bb4, ^bb10
      aie.use_lock(%buf_lhs_0_1_cons_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_lhs_0_1 : memref<2048xf32>, 0, 1024)
      aie.use_lock(%buf_lhs_0_1_prod_lock, Release, 1)
      aie.next_bd ^bb10
    ^bb11:  // 2 preds: ^bb5, ^bb11
      aie.use_lock(%buf_rhs_0_1_cons_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_rhs_0_1 : memref<1024xf32>, 0, 1024)
      aie.use_lock(%buf_rhs_0_1_prod_lock, Release, 1)
      aie.next_bd ^bb11
    ^bb12:  // pred: ^bb5
      aie.end
    }

    %mem_0_2 = aie.mem(%tile_0_2) {
      %0 = aie.dma_start(S2MM, 0, ^bb3, ^bb1)
    ^bb1:  // pred: ^bb0
      %1 = aie.dma_start(S2MM, 1, ^bb4, ^bb2)
    ^bb2:  // pred: ^bb1
      %2 = aie.dma_start(MM2S, 0, ^bb5, ^bb6)
    ^bb3:  // 2 preds: ^bb0, ^bb3
      aie.use_lock(%buf_lhs_0_2_prod_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_lhs_0_2 : memref<1024xf32>, 0, 1024)
      aie.use_lock(%buf_lhs_0_2_cons_lock, Release, 1)
      aie.next_bd ^bb3
    ^bb4:  // 2 preds: ^bb1, ^bb4
      aie.use_lock(%buf_rhs_0_2_prod_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_rhs_0_2 : memref<1024xf32>, 0, 1024)
      aie.use_lock(%buf_rhs_0_2_cons_lock, Release, 1)
      aie.next_bd ^bb4
    ^bb5:  // 2 preds: ^bb2, ^bb5
      aie.use_lock(%buf_res_0_2_cons_lock, AcquireGreaterEqual, 1)
      aie.dma_bd(%buf_res_0_2 : memref<1024xf32>, 0, 1024)
      aie.use_lock(%buf_res_0_2_prod_lock, Release, 1)
      aie.next_bd ^bb5
    ^bb6:  // pred: ^bb2
      aie.end
    }

    %core_0_2 = aie.core(%tile_0_2) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c1024 = arith.constant 1024 : index
      %intmax = arith.constant 0xFFFFFFFF : index

      scf.for %arg = %c0 to %intmax step %c1 {
        aie.use_lock(%buf_lhs_0_2_cons_lock, AcquireGreaterEqual, 1)
        aie.use_lock(%buf_res_0_2_prod_lock, AcquireGreaterEqual, 1)

        scf.for %idx = %c0 to %c1024 step %c1 {
          %val = memref.load %buf_lhs_0_2[%idx] : memref<1024xf32>
          memref.store %val, %buf_res_0_2[%idx] : memref<1024xf32>
        }

        aie.use_lock(%buf_lhs_0_2_prod_lock, Release, 1)
        aie.use_lock(%buf_res_0_2_cons_lock, Release, 1)
      }

      aie.end
    } {link_with = "kernel.o"}

    aiex.runtime_sequence @sequence(%arg0: memref<64x32xf32>, %arg1: memref<32x32xf32>, %arg2: memref<64x32xf32>) {
      aiex.npu.dma_memcpy_nd(%arg0[0, 0, 0, 0][1, 1, 64, 32][0, 0, 32, 1]) {id = 0 : i64, metadata = @global_lhs_0_0} : memref<64x32xf32>
      aiex.npu.dma_memcpy_nd(%arg1[0, 0, 0, 0][1, 1, 32, 32][0, 0, 32, 1]) {id = 1 : i64, metadata = @global_rhs_0_0} : memref<32x32xf32>
      aiex.npu.dma_memcpy_nd(%arg2[0, 0, 0, 0][1, 1, 64, 32][0, 0, 32, 1]) {id = 2 : i64, metadata = @global_res_0_0, issue_token=true} : memref<64x32xf32>
      aiex.npu.dma_wait {symbol = @global_res_0_0}
    }
  }
}
